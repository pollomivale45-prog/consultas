# AWS S3 / Cloudflare R2 Credentials
# Get these from Cloudflare R2 dashboard
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=configs

# External APIs
# Get BIN_API_KEY from laboratorio.lol
BIN_API_KEY=your_bin_api_key

# URL for external BIN checker service
LABORATORIO_LOL_URL=https://laboratorio.lol/api/bins.php

# Laboratorio.lol API key for telegram credentials
LABORATORIO_LOL_API_KEY=your_laboratorio_lol_api_key

# Telegram Bot Credentials
# These are obtained dynamically from laboratorio.lol
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# Server Configuration
PORT=9090
NODE_ENV=production
