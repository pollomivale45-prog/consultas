{
  "version": 2,
  "public": true,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/:path.html"
    },
    {
      "source": "/:path((?!api/).+)\\.html",
      "destination": "/:path.html"
    }
  ]
}
