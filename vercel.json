{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/obtener-datos-:tipo/:txid",
      "destination": "/api/obtener-datos.js?tipo=:tipo&txid=:txid"
    },
    {
      "source": "/api/guardar-datos-:tipo/:txid",
      "destination": "/api/guardar-datos.js?tipo=:tipo&txid=:txid"
    },
    {
      "source": "/api/obtener-accion/:txid",
      "destination": "/api/obtener-accion.js?txid=:txid"
    },
    {
      "source": "/api/guardar-accion/:txid",
      "destination": "/api/guardar-accion.js?txid=:txid"
    },
    {
      "source": "/api/limpiar-accion/:txid",
      "destination": "/api/limpiar-accion.js?txid=:txid"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/:path.html"
    },
    {
      "source": "/:path((?!api/).+)\\.html",
      "destination": "/:path.html"
    }
  ]
}
